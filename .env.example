# Required, with no defaults in the code or in compose. Copy to .env: cp .env.example .env
# Inside compose the app always uses db:5432; POSTGRES_PORT is also the port published on the host.
POSTGRES_HOST=localhost
POSTGRES_USER=competitor_pulse
POSTGRES_PASSWORD=competitor_pulse
POSTGRES_DB=competitor_pulse
POSTGRES_PORT=5432

# Optional. The port the API listens on.
# PORT=3000

# Optional. Set to true to log every SQL query.
# LOG_SQL=false

# Optional. The built web app's folder. Defaults to web/dist.
# WEB_DIST_DIR=

# Optional. How often each competitor is polled, and how often the worker looks for due ones.
# POLL_INTERVAL_SECONDS=900
# CHECK_INTERVAL_SECONDS=15

# LLM providers. A provider is available only if its key is set, so set at least one.
# The mock needs no real key: python3 files/mock-llm/mock-llm-server.py
# Remove it when you add a real key, or it stays on as the last fallback.
MOCK_API_KEY=mock
# MOCK_BASE_URL=http://localhost:4001/v1
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=

# Optional. <PROVIDER>_MODEL and <PROVIDER>_BASE_URL override a provider's defaults.
# LLM_PROVIDER_ORDER=deepseek,openai,anthropic,gemini,mistral,groq,xai,mock
# LLM_MAX_ATTEMPTS=3
